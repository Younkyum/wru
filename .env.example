# Meta Model API (OpenAI 호환). 비워 두면 결정론적 mock Muse로 돌아갑니다.
MODEL_API_KEY=
MODEL_API_BASE_URL=https://api.meta.ai/v1
# 모델 id는 가정값입니다. 실제 id가 다르면 덮어쓰세요.
MUSE_MODEL=muse-spark-1.3

# 로컬 API 서버 포트 (Vite dev 프록시가 이 포트로 /api를 넘깁니다)
WRU_API_PORT=8787

# 가족 설정 파일 경로 (없으면 세 명 모두 시뮬레이터). family.config.example.json 참고
# WRU_FAMILY_CONFIG=family.config.json
# 구성원이 자기 WhereCtx를 연결할 때: 그 WhereCtx에서 발급한 agent 토큰 (변수 이름은 family.config.json의 token_env와 같게)
# WRU_WHERECTX_TOKEN_MOM=

# WRU 에이전트 토큰. 비워 두면 서버가 시작할 때마다 새로 만든다 (외부 에이전트를 붙일 때만 고정)
# WRU_AGENT_TOKEN_MOM=
# WRU_AGENT_TOKEN_DAD=
# WRU_AGENT_TOKEN_SIBLING=

# 가족 대시보드 API 보호. 설정하면 /demo#key=<값>으로 연다 (공개 서버에 올릴 때 권장)
# WRU_ADMIN_TOKEN=
